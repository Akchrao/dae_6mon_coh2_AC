flowchart TD
  S([Start]) --> A[/"Receive identity event:<br>joiner, mover, leaver<br>or access request"/]
  A --> L{"Leaver?"}
  B(("&nbsp;B&nbsp;")) -.-> A
  L -- Yes --> LD["Disable account in Entra ID<br>and Keycloak; remove all roles"]
  LD --> LV{"Sign-in refused<br>in both?"}
  LV -- No --> GAP["Raise finding + risk<br>(deprovisioning gap)"] --> LD
  LV -- Yes --> C1
  L -- No --> R["Look up job role<br>in the RBAC matrix"]
  R --> W{"Within role?<br>(least privilege)"}
  W -- No --> AP{"Manager + IAM<br>approved?"}
  AP -- No --> DN[/"Deny and<br>record reason"/] --> C1
  AP -- Yes --> MV
  W -- Yes --> MV{"Mover?"}
  MV -- Yes --> RM["Remove old role first"] --> PR
  MV -- No --> PR["Grant role through<br>Keycloak group"]
  PR --> PV{"Privileged role?"}
  PV -- Yes --> MFA["Require MFA"] --> SI
  PV -- No --> SI[/"User signs in;<br>app gate allows or denies"/]
  SI --> C1(("&nbsp;A&nbsp;"))
